# Doxygen configuration for IDet.
#
# Keep generated output under docs/doxygen so the API reference can be served
# directly from the repository tree during local development.

PROJECT_NAME           = "IDet"
PROJECT_BRIEF          = "CPU-only C++ image detection library for real-time pipelines"
PROJECT_LOGO           = docs/assets/idet_logo.png
OUTPUT_DIRECTORY       = docs/doxygen

CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

INPUT                  = docs/doxygen/mainpage.md \
                         README.md \
                         docs/index.md \
                         docs/requirements.md \
                         docs/build.md \
                         docs/model-zoo.md \
                         docs/cli.md \
                         docs/quick-start.md \
                         docs/integration.md \
                         docs/performance.md \
                         docs/troubleshooting.md \
                         docs/doxygen.md \
                         docs/doxygen/api-groups.dox \
                         include \
                         src \
                         examples \
                         tests

USE_MDFILE_AS_MAINPAGE = docs/doxygen/mainpage.md
FILE_PATTERNS          = *.h *.hpp *.cpp *.md *.dox
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */docs/doxygen/html/* \
                         */build*/* \
                         */subprojects/* \
                         */assets/* \
                         */meson-private/* \
                         */meson-logs/* \
                         */.git/* \
                         */__pycache__/*

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include src/lib

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = YES
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB
TOC_INCLUDE_HEADINGS   = 5
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
IDL_PROPERTY_SUPPORT   = NO

ALIASES                = "thread_safety=@par Thread safety"

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS_PRINT
WARN_FORMAT            = "$file:$line: $text"

QUIET                  = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = docs/doxygen/doxygen-theme.css
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
DISABLE_INDEX          = NO
HTML_INDEX_NUM_ENTRIES = 140
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_CLEANUP            = YES
